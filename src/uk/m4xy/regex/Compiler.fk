import fckt.collections.Arrays.*

module Compiler {
  compile(pattern: Pattern): Program = {
    body = code(pattern.node, 1)
    instructions = [Save(0)] + body + [Save(1), Succeed]
    Program(instructions.toArray(), 2 * (pattern.groups + 1), pattern.ignoreCase)
  }

  code(node: Node, start: Int): List<Instruction> = when (node) {
    Empty -> []
    Literal(c) -> [Take(Exactly(c))]
    AnyCharacter -> [Take(AnyButNewline)]
    CharacterClass(ranges, negated) -> [Take(InRanges(ranges, negated))]
    Assert(assertion) -> [Check(assertion)]
    Group(None, inside) -> code(inside, start)
    Group(Some(n), inside) -> [Save(2 * n)] + code(inside, start + 1) + [Save(2 * n + 1)]
    Sequence(nodes) -> sequenceCode(nodes, start)
    Choice(alternatives) -> choiceCode(alternatives, start)
    Repeat(inside, min, max, greedy) -> repeatCode(inside, min, max, greedy, start)
  }

  private sequenceCode(nodes: List<Node>, start: Int): List<Instruction> = when (nodes) {
    [] -> []
    [first, *rest] -> {
      firstCode = code(first, start)
      firstCode + sequenceCode(rest, start + firstCode.size)
    }
  }

  private choiceCode(alternatives: List<Node>, start: Int): List<Instruction> = when (alternatives) {
    [] -> []
    [only] -> code(only, start)
    [first, *rest] -> {
      firstCode = code(first, start + 1)
      restStart = start + 1 + firstCode.size + 1
      restCode = choiceCode(rest, restStart)
      [Split(start + 1, restStart)] + firstCode + [Jump(restStart + restCode.size)] + restCode
    }
  }

  private repeatCode(inside: Node, min: Int, max: Option<Int>, greedy: Boolean, start: Int): List<Instruction> = {
    required = copies(inside, min, start)
    afterRequired = start + required.size
    more = when (max) {
      Some(m) -> optionals(inside, m - min, greedy, afterRequired)
      None -> star(inside, greedy, afterRequired)
    }
    required + more
  }

  private copies(inside: Node, count: Int, start: Int): List<Instruction> =
    if (count <= 0) []
    else {
      one = code(inside, start)
      one + copies(inside, count - 1, start + one.size)
    }

  private optionals(inside: Node, count: Int, greedy: Boolean, start: Int): List<Instruction> =
    if (count <= 0) []
    else {
      one = code(inside, start + 1)
      rest = optionals(inside, count - 1, greedy, start + 1 + one.size)
      end = start + 1 + one.size + rest.size
      [preferring(greedy, start + 1, end)] + one + rest
    }

  private star(inside: Node, greedy: Boolean, start: Int): List<Instruction> = {
    one = code(inside, start + 1)
    end = start + 1 + one.size + 1
    [preferring(greedy, start + 1, end)] + one + [Jump(start)]
  }

  private preferring(greedy: Boolean, goOn: Int, leave: Int): Instruction =
    if (greedy) Split(goOn, leave) else Split(leave, goOn)
}
