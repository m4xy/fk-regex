type Node {
  Empty,
  Literal(c: Char),
  AnyCharacter,
  CharacterClass(ranges: List<CharRange>, negated: Boolean),
  Assert(assertion: Assertion),
  Group(number: Option<Int>, node: Node),
  Sequence(nodes: List<Node>),
  Choice(alternatives: List<Node>),
  Repeat(node: Node, min: Int, max: Option<Int>, greedy: Boolean),
}
