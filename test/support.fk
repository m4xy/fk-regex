import uk.m4xy.regex.*
import uk.m4xy.regex.Regexes.*

// What the tests share.

// The pattern, compiled, which the tests' patterns are.
r(pattern: String): Regex = when (regex(pattern)) {
  Ok(compiled) -> compiled
  Error(e) -> error("/$pattern/ doesn't compile: ${e.message}")
}

// What the pattern finds first in the text.
found(pattern: String, text: String): Option<String> = r(pattern).find(text).map { it.value }
